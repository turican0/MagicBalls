[configuration]

entry_symbol = "mbex_library_init"
compatibility_minimum = "4.1"

[libraries]
; Relative paths from godot-code/addons/MBEX/ to godot-code/MBEXout/bin/
macos.single.debug = "../../MBEXout/bin/macos/libEXTENSION-NAME.macos.template_debug.dylib"
macos.double.debug = "../../MBEXout/bin/macos/libEXTENSION-NAME.macos.template_debug.double.dylib"
macos.single.release = "../../MBEXout/bin/macos/libEXTENSION-NAME.macos.template_release.dylib"
macos.double.release = "../../MBEXout/bin/macos/libEXTENSION-NAME.macos.template_release.double.dylib"

ios.arm64.single.debug = "../../MBEXout/bin/ios/libEXTENSION-NAME.ios.template_debug.arm64.dylib"
ios.arm64.double.debug = "../../MBEXout/bin/ios/libEXTENSION-NAME.ios.template_debug.arm64.double.dylib"
ios.arm64.single.release = "../../MBEXout/bin/ios/libEXTENSION-NAME.ios.template_release.arm64.dylib"
ios.arm64.double.release = "../../MBEXout/bin/ios/libEXTENSION-NAME.ios.template_release.arm64.double.dylib"

windows.x86_32.single.debug = "../../MBEXout/bin/windows/EXTENSION-NAME.windows.template_debug.x86_32.dll"
windows.x86_32.double.debug = "../../MBEXout/bin/windows/EXTENSION-NAME.windows.template_debug.x86_32.double.dll"
windows.x86_32.single.release = "../../MBEXout/bin/windows/EXTENSION-NAME.windows.template_release.x86_32.dll"
windows.x86_32.double.release = "../../MBEXout/bin/windows/EXTENSION-NAME.windows.template_release.x86_32.double.dll"

windows.x86_64.single.debug = "../../MBEXout/bin/windows/EXTENSION-NAME.windows.template_debug.x86_64.debug.dll"
windows.x86_64.double.debug = "../../MBEXout/bin/windows/EXTENSION-NAME.windows.template_debug.x86_64.debug.dll"
windows.x86_64.single.release = "../../MBEXout/bin/windows/EXTENSION-NAME.windows.template_debug.x86_64.dll"
windows.x86_64.double.release = "../../MBEXout/bin/windows/EXTENSION-NAME.windows.template_debug.x86_64.dll"

linux.x86_64.single.debug = "../../MBEXout/bin/linux/MagicBalls.linux.template_debug.x86_64.debug.so"
linux.x86_64.double.debug = "../../MBEXout/bin/linux/MagicBalls.linux.template_debug.x86_64.debug.so"
linux.x86_64.single.release = "../../MBEXout/bin/linux/MagicBalls.linux.template_debug.x86_64.so"
linux.x86_64.double.release = "../../MBEXout/bin/linux/MagicBalls.linux.template_debug.x86_64.so"

linux.arm64.single.debug = "../../MBEXout/bin/linux/libEXTENSION-NAME.linux.template_debug.arm64.so"
linux.arm64.double.debug = "../../MBEXout/bin/linux/libEXTENSION-NAME.linux.template_debug.arm64.double.so"
linux.arm64.single.release = "../../MBEXout/bin/linux/libEXTENSION-NAME.linux.template_release.arm64.so"
linux.arm64.double.release = "../../MBEXout/bin/linux/libEXTENSION-NAME.linux.template_release.arm64.double.so"

linux.rv64.single.debug = "../../MBEXout/bin/linux/libEXTENSION-NAME.linux.template_debug.rv64.so"
linux.rv64.double.debug = "../../MBEXout/bin/linux/libEXTENSION-NAME.linux.template_debug.rv64.double.so"
linux.rv64.single.release = "../../MBEXout/bin/linux/libEXTENSION-NAME.linux.template_release.rv64.so"
linux.rv64.double.release = "../../MBEXout/bin/linux/libEXTENSION-NAME.linux.template_release.rv64.double.so"

android.x86_64.single.debug = "res://MBEXout/bin/android/libEXTENSION-NAME.android.template_debug.x86_64.so"
android.x86_64.double.debug = "res://MBEXout/bin/android/libEXTENSION-NAME.android.template_debug.x86_64.double.so"
android.x86_64.single.release = "res://MBEXout/bin/android.x86_64/MagicBalls.android.x86_64.template_release.x86_64.so"
android.x86_64.double.release = "res://MBEXout/bin/android.x86_64/MagicBalls.android.x86_64.template_release.x86_64.so"

android.arm64.single.debug = "res://MBEXout/bin/android/libEXTENSION-NAME.android.template_debug.arm64.so"
android.arm64.double.debug = "res://MBEXout/bin/android/libEXTENSION-NAME.android.template_debug.arm64.double.so"
android.arm64.single.release = "res://MBEXout/bin/android.arm64-v8a/MagicBalls.android.arm64-v8a.template_release.arm64.so"
android.arm64.double.release = "res://MBEXout/bin/android.arm64-v8a/MagicBalls.android.arm64-v8a.template_release.arm64.so"

web.wasm32.single.debug = "../../MBEXout/bin/web/libEXTENSION-NAME.web.template_debug.wasm32.nothreads.wasm"
web.wasm32.double.debug = "../../MBEXout/bin/web/libEXTENSION-NAME.web.template_debug.wasm32.double.nothreads.wasm"
web.wasm32.single.release = "../../MBEXout/bin/web/libEXTENSION-NAME.web.template_release.wasm32.nothreads.wasm"
web.wasm32.double.release = "../../MBEXout/bin/web/libEXTENSION-NAME.web.template_release.wasm32.double.nothreads.wasm"
